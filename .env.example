DATABASE_URL=pglite:./data/pglite
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
AGENT_ENGINE=openai
AGENT_MAX_ITERATIONS=8
AGENT_MAX_RUN_INPUT_TOKENS=50000
SHORTLIST_SPONSORED_AI=false
SHORTLIST_DAILY_AI_LIMIT=20
SHORTLIST_USER_DAILY_AI_LIMIT=5

# Hosted deployments require persistent PostgreSQL, a stable auth secret,
# and an explicitly configured model provider. PGlite is development only.
