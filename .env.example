DATABASE_URL=pglite:./data/pglite
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
VULTR_INFERENCE_API_KEY=
AGENT_MODEL=deepseek-v4.1-flash-1017
AGENT_ENGINE=ai-sdk:openai
AGENT_MAX_ITERATIONS=8
AGENT_MAX_RUN_INPUT_TOKENS=50000
SHORTLIST_SPONSORED_AI=false

# Hosted deployments require persistent PostgreSQL, a stable auth secret,
# and a Vultr inference key. The app pins Vultr for agent, transcription and
# speech requests. PGlite is development only.
